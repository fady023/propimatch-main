{
  "expo": {
    "name": "Propimatch",
    "slug": "propimatch",
    "scheme": "propimatch",
    "version": "0.1.0",
    "orientation": "portrait",
    
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1215"
    },
    "updates": { "fallbackToCacheTimeout": 0 },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": { },
    "web": { "bundler": "metro" }
  }
}

